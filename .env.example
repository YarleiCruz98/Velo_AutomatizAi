VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Used only by Playwright database helpers. Always point this to preview.
DATABASE_URL="postgresql://postgres.project-ref:password@host:6543/postgres"
SUPABASE_PROJECT_REF_PREVIEW="preview-project-ref"
SUPABASE_PROJECT_REF_PRODUCTION="production-project-ref"
